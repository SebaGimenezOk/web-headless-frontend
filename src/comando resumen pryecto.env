echo -e "=====================================
=============\nESTRUCTURA DEL PROYECTO\n=========================
=========================" >
 resumen_proyecto.txt && find . -maxdepth 3 -not -path '*/.*' -not -path './node_modules*' 
 -not -path './.next*' -not -path './out*' -not -path './dist*' | sort >> resumen_proyecto.txt && 
 echo -e "\n==================================================\nARCHIVOS CLAVE DE CONFIGURACIÓN
  Y CÓDIGO\n==================================================" >> resumen_proyecto.txt 
  && for f in package.json next.config.js next.config.mjs tailwind.config.js 
  tailwind.config.ts tsconfig.json .env.local .env.example src/middleware.ts src/middleware.js; 
  do if [ -f "$f" ]; then echo -e "\n--------------------------------------------------\nARCHIVO: 
  $f\n--------------------------------------------------" >> resumen_proyecto.txt && cat "$f" 
 >> resumen_proyecto.txt; fi; done


